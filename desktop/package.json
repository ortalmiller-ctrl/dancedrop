{
  "name": "dancedrop-companion",
  "productName": "DanceDrop",
  "version": "1.0.1",
  "description": "DanceDrop desktop companion - consent-based remote animations",
  "main": "src/main.js",
  "author": {
    "name": "DanceDrop"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.dancedrop.companion",
    "productName": "DanceDrop",
    "artifactName": "DanceDrop-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DanceDrop",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}