{
  "name": "AnimationCharacter",
  "description": "Character library available to the admin console and the overlay renderer.",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Renderer key, e.g. banana."
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "accent_color": {
      "type": "string"
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supported animation keys: dance, jump, spin, wave, bounce."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}