{
  "name": "DeviceDownload",
  "description": "Companion download requests, tracked separately from installation activations.",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "default": "unknown"
    },
    "source": {
      "type": "string",
      "default": "website"
    },
    "client_type": {
      "type": "string",
      "default": "desktop"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}